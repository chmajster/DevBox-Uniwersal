DEVBOX_HTTP_ADDR=127.0.0.1:8787
DEVBOX_DATABASE_PATH=./data/devbox.db
DEVBOX_MIGRATIONS_DIR=./migrations
DEVBOX_PROJECTS_ROOT=./projects
# Optional additional filesystem roots visible in the local-directory browser.
# Linux/WSL uses ":" as the separator, for example: /home/chris:/mnt/c/Users/Chris/Documents/GitHub
DEVBOX_DIRECTORY_BROWSE_ROOTS=
DEVBOX_SESSION_TTL=24h
DEVBOX_COOKIE_SECURE=false
DEVBOX_BOOTSTRAP_ADMIN_USERNAME=admin
DEVBOX_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
# Generate once and store outside the repository: openssl rand -base64 32
DEVBOX_MASTER_KEY=
# MySQL/MariaDB administrative connection used only by the database provider.
# Application projects never receive this account.
DEVBOX_MYSQL_HOST=127.0.0.1
DEVBOX_MYSQL_PORT=3306
DEVBOX_MYSQL_ADMIN_USER=devbox_admin
DEVBOX_MYSQL_ADMIN_PASSWORD=
DEVBOX_MYSQL_APP_HOST=%
DEVBOX_MYSQL_BIN=mysql
DEVBOX_MYSQLDUMP_BIN=mysqldump
DEVBOX_MYSQL_BACKUP_DIR=./data/backups/mysql

# phpMyAdmin is managed as an independent Docker container.
DEVBOX_DOCKER_BIN=docker
DEVBOX_PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache
DEVBOX_PHPMYADMIN_CONTAINER=devbox-phpmyadmin
DEVBOX_PHPMYADMIN_PORT=8081

# Networking / reverse proxy
DEVBOX_PORT_RANGE_START=8000
DEVBOX_PORT_RANGE_END=8999
DEVBOX_NGINX_BINARY=nginx
DEVBOX_NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
DEVBOX_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
# Leave empty for automatic Windows/WSL/Linux hosts-file detection.
DEVBOX_HOSTS_FILE=
DEVBOX_HEALTH_TIMEOUT=5s

VITE_API_BASE=/api/v1
