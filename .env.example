DEVBOX_HTTP_ADDR=127.0.0.1:8787
DEVBOX_DATABASE_PATH=./data/devbox.db
DEVBOX_MIGRATIONS_DIR=./migrations
DEVBOX_SESSION_TTL=24h
DEVBOX_COOKIE_SECURE=false
DEVBOX_BOOTSTRAP_ADMIN_USERNAME=admin
DEVBOX_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
# Generate once and store outside the repository: openssl rand -base64 32
DEVBOX_MASTER_KEY=

# Networking / reverse proxy
DEVBOX_PORT_RANGE_START=8000
DEVBOX_PORT_RANGE_END=8999
DEVBOX_NGINX_BINARY=nginx
DEVBOX_NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
DEVBOX_NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
# Leave empty for automatic Windows/WSL/Linux hosts-file detection.
DEVBOX_HOSTS_FILE=
DEVBOX_HEALTH_TIMEOUT=5s

VITE_API_BASE=/api/v1
